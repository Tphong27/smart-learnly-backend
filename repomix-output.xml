    ON public.lesson_progress (lesson_identity_id)
    WHERE lesson_identity_id IS NOT NULL;

CREATE INDEX IF NOT EXISTS idx_lesson_progress_class_identity
    ON public.lesson_progress (class_id, lesson_identity_id)
