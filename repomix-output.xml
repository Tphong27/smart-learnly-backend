        seedActiveUser();
        seedPendingUser();
        seedGoogleOnlyUser();

        authService.forgotPassword(new ForgotPasswordRequest(ACTIVE_EMAIL));
        resendVerificationOtpForSeed();

        log.info("Dev auth seed ready");
