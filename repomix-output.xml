@Getter
@Setter
@NoArgsConstructor
@Entity
@Table(name = "video_ai_contents", schema = "public")
public class VideoAiContent {
    @Id
    @GeneratedValue
    private UUID id;
    @Column(name = "lesson_id", nullable = false)
    private UUID lessonId;
    @Column(name = "lesson_scope", nullable = false, length = 16)
