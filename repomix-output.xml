@Table(name = "lesson_progress", schema = "public")
public class LessonProgress {
    @Id
    @GeneratedValue
    private UUID id;

    @Column(name = "student_id", nullable = false)
    private UUID studentId;

    @Column(name = "course_id", nullable = false)
