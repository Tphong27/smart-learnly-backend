                            assertThat(
                                    exception.errorCode())
                                    .isEqualTo(
                                            ErrorCode.EXTERNAL_SERVICE_UNAVAILABLE);

                            assertThat(
                                    exception.getMessage())
                                    .contains("disabled");
                        });
    }
