@Getter
@Setter
@NoArgsConstructor
@Entity
@Table(name = "classes", schema = "public")
public class ClassOffering {
    @Id
    @GeneratedValue
    private UUID id;

    @Column(name = "course_id", nullable = false)
    private UUID courseId;

    @Column(name = "class_name", nullable = false)
